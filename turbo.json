{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "cacheDir": ".turbo/cache",
  "tasks": {
    "lint": {},
    "typecheck": {},
    "test": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "a11y": {
      "cache": false
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
