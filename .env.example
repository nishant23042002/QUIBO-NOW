# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Variables are validated by packages/config (a bad value fails the build and names the variable).

# local | staging | production
APP_ENV=local

# Where the customer app is served. Used for absolute URLs in page metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local infrastructure from infra/docker-compose.yml. Needed from Phase 2.
# POSTGRES_PASSWORD has no default: choose one for your own machine.
POSTGRES_USER=quibo
POSTGRES_PASSWORD=
POSTGRES_DB=quibo
POSTGRES_PORT=5432
REDIS_PORT=6379

# Connection strings the API uses from Phase 2, for example:
#   DATABASE_URL=postgresql://quibo:<your password>@localhost:5432/quibo
#   REDIS_URL=redis://localhost:6379
DATABASE_URL=
REDIS_URL=
